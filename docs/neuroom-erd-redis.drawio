<mxfile>
  <diagram name="Neuroom ERD + Redis" id="neuroom-erd">
    <mxGraphModel dx="1" dy="1" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== SECTION TITLE: MYSQL ===== -->
        <mxCell id="title-mysql" value="&lt;b&gt;Neuroom — MySQL ERD&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="40" as="geometry" />
        </mxCell>

        <!-- ===== TABLE 1: users ===== -->
        <mxCell id="t-users" value='&lt;table border="0" cellpadding="4" cellspacing="0" width="100%"&gt;&lt;tr&gt;&lt;td style="background-color:#1a73e8;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;border-radius:4px 4px 0 0;" colspan="2"&gt;👤 users&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#e8f0fe;font-weight:bold;border-bottom:1px solid #ccc;"&gt;&lt;u&gt;id&lt;/u&gt; 🔑 PK&lt;/td&gt;&lt;td style="background-color:#e8f0fe;border-bottom:1px solid #ccc;"&gt;BIGINT (auto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;username&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(255) UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;display_name&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;email&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(255) UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;password&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(255)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;is_admin&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;TINYINT defaults 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;profile_picture&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(255) nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;created_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;updated_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1a73e8;strokeWidth=2;verticalAlign=top;overflow=hidden;fontSize=11;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="290" height="270" as="geometry" />
        </mxCell>

        <!-- ===== TABLE 2: notes ===== -->
        <mxCell id="t-notes" value='&lt;table border="0" cellpadding="4" cellspacing="0" width="100%"&gt;&lt;tr&gt;&lt;td style="background-color:#34a853;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;border-radius:4px 4px 0 0;" colspan="2"&gt;📝 notes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#e6f4ea;font-weight:bold;border-bottom:1px solid #ccc;"&gt;&lt;u&gt;id&lt;/u&gt; 🔑 PK&lt;/td&gt;&lt;td style="background-color:#e6f4ea;border-bottom:1px solid #ccc;"&gt;BIGINT (auto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#e6f4ea;font-weight:bold;border-bottom:1px solid #ccc;"&gt;user_id 🔗 FK&lt;/td&gt;&lt;td style="background-color:#e6f4ea;border-bottom:1px solid #ccc;"&gt;BIGINT → users.id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;title&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(200)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;content&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;created_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;updated_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#34a853;strokeWidth=2;verticalAlign=top;overflow=hidden;fontSize=11;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="390" y="70" width="290" height="195" as="geometry" />
        </mxCell>

        <!-- ===== TABLE 3: pomodoro_histories ===== -->
        <mxCell id="t-pomo" value='&lt;table border="0" cellpadding="4" cellspacing="0" width="100%"&gt;&lt;tr&gt;&lt;td style="background-color:#ea4335;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;border-radius:4px 4px 0 0;" colspan="2"&gt;🍅 pomodoro_histories&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#fce8e6;font-weight:bold;border-bottom:1px solid #ccc;"&gt;&lt;u&gt;id&lt;/u&gt; 🔑 PK&lt;/td&gt;&lt;td style="background-color:#fce8e6;border-bottom:1px solid #ccc;"&gt;BIGINT (auto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#fce8e6;font-weight:bold;border-bottom:1px solid #ccc;"&gt;user_id 🔗 FK&lt;/td&gt;&lt;td style="background-color:#fce8e6;border-bottom:1px solid #ccc;"&gt;BIGINT → users.id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;pomodoro_uid&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(255) UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;status&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(255) finished/stopped&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;duration_seconds&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;UNSIGNED INT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;actual_seconds&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;UNSIGNED INT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;remaining_seconds&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;INT nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;started_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;DATETIME nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;finished_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;DATETIME nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;stopped_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;DATETIME nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;created_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;updated_at&lt;/td&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ea4335;strokeWidth=2;verticalAlign=top;overflow=hidden;fontSize=11;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="290" height="350" as="geometry" />
        </mxCell>

        <!-- ===== TABLE 4: sessions ===== -->
        <mxCell id="t-sessions" value='&lt;table border="0" cellpadding="4" cellspacing="0" width="100%"&gt;&lt;tr&gt;&lt;td style="background-color:#f9ab00;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;border-radius:4px 4px 0 0;" colspan="2"&gt;🔐 sessions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#fef7e0;font-weight:bold;border-bottom:1px solid #ccc;"&gt;&lt;u&gt;id&lt;/u&gt; 🔑 PK&lt;/td&gt;&lt;td style="background-color:#fef7e0;border-bottom:1px solid #ccc;"&gt;VARCHAR(255)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#fef7e0;font-weight:bold;border-bottom:1px solid #ccc;"&gt;user_id 🔗 FK (idx)&lt;/td&gt;&lt;td style="background-color:#fef7e0;border-bottom:1px solid #ccc;"&gt;BIGINT → users.id nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;ip_address&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;VARCHAR(45) nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;user_agent&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;TEXT nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;payload&lt;/td&gt;&lt;td style="border-bottom:1px solid #eee;"&gt;LONGTEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;last_activity (idx)&lt;/td&gt;&lt;td style="border-bottom:1px solid #ddd;"&gt;INTEGER index&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#f9ab00;strokeWidth=2;verticalAlign=top;overflow=hidden;fontSize=11;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="390" y="370" width="290" height="195" as="geometry" />
        </mxCell>

        <!-- ===== RELATIONSHIPS ===== -->
        <!-- users -> notes -->
        <mxCell id="rel-users-notes" style="edgeStyle=entityRelationEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#34a853;strokeWidth=2;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="t-users" target="t-notes">
          <mxGeometry width="100" height="100" relative="1" as="geometry">
            <mxPoint x="330" y="150" as="sourcePoint" />
            <mxPoint x="390" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- users -> pomodoro_histories -->
        <mxCell id="rel-users-pomo" style="edgeStyle=entityRelationEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea4335;strokeWidth=2;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t-users" target="t-pomo">
          <mxGeometry width="100" height="100" relative="1" as="geometry">
            <mxPoint x="185" y="340" as="sourcePoint" />
            <mxPoint x="185" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- users -> sessions -->
        <mxCell id="rel-users-sessions" style="edgeStyle=entityRelationEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f9ab00;strokeWidth=2;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t-notes" target="t-sessions">
          <mxGeometry width="100" height="100" relative="1" as="geometry">
            <mxPoint x="535" y="265" as="sourcePoint" />
            <mxPoint x="535" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== SECTION TITLE: REDIS ===== -->
        <mxCell id="title-redis" value="&lt;b&gt;Neuroom — Redis Structure&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="640" height="40" as="geometry" />
        </mxCell>

        <!-- Redis key 1: pomodoro:current -->
        <mxCell id="redis-pomo" value='&lt;table border="0" cellpadding="4" cellspacing="0" width="100%"&gt;&lt;tr&gt;&lt;td style="background-color:#dc3545;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;border-radius:4px 4px 0 0;"&gt;🔥 Redis Key: user:{id}:pomodoro:current&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#fff5f5;font-size:10px;border-bottom:1px solid #ddd;"&gt;📌 SETEX with TTL (remaining + buffer)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;font-family:Consolas;font-size:10px;"&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"id": "uuid",&lt;br&gt;&amp;nbsp;&amp;nbsp;"status": "running | paused | idle",&lt;br&gt;&amp;nbsp;&amp;nbsp;"type": "focus | break",&lt;br&gt;&amp;nbsp;&amp;nbsp;"duration": 1500,&lt;br&gt;&amp;nbsp;&amp;nbsp;"remaining": 1200,&lt;br&gt;&amp;nbsp;&amp;nbsp;"ends_at": "ISO8601",&lt;br&gt;&amp;nbsp;&amp;nbsp;"paused_at": "ISO8601 | null",&lt;br&gt;&amp;nbsp;&amp;nbsp;"started_at": "ISO8601",&lt;br&gt;&amp;nbsp;&amp;nbsp;"auto_start_break": true,&lt;br&gt;&amp;nbsp;&amp;nbsp;"auto_start_focus": false&lt;br&gt;}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#fff0f0;font-size:10px;border-top:1px solid #ddd;color:#666;"&gt;💡 DEL on stop/finish · TTL auto-expire&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dc3545;strokeWidth=2;verticalAlign=top;overflow=hidden;fontSize=11;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="290" height="240" as="geometry" />
        </mxCell>

        <!-- Redis key 2: summary -->
        <mxCell id="redis-summary" value='&lt;table border="0" cellpadding="4" cellspacing="0" width="100%"&gt;&lt;tr&gt;&lt;td style="background-color:#6f42c1;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;border-radius:4px 4px 0 0;"&gt;📄 Redis Key: user:{id}:summary&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#f3e8ff;font-size:10px;border-bottom:1px solid #ddd;"&gt;📌 SET (no TTL — persistent until consumed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;font-family:Consolas;font-size:10px;"&gt;📝 Gemini AI summary text &lt;br&gt;👇 &lt;b&gt;addToNotes()&lt;/b&gt; creates a Note &amp; DEL key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#f3e8ff;font-size:10px;border-top:1px solid #ddd;color:#666;"&gt;💡 Auto-deleted when moved to notes table&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6f42c1;strokeWidth=2;verticalAlign=top;overflow=hidden;fontSize=11;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="390" y="810" width="290" height="150" as="geometry" />
        </mxCell>

        <!-- Redis key 3: user:* (wildcard cleanup on logout) -->
        <mxCell id="redis-wildcard" value='&lt;table border="0" cellpadding="4" cellspacing="0" width="100%"&gt;&lt;tr&gt;&lt;td style="background-color:#fd7e14;color:#ffffff;font-weight:bold;font-size:13px;text-align:center;border-radius:4px 4px 0 0;"&gt;🧹 KEYS: user:{id}:*&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#fff3e0;font-size:10px;border-bottom:1px solid #ddd;"&gt;📌 On logout → KEYS user:{id}:* → DEL each&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border-bottom:1px solid #eee;font-family:Consolas;font-size:10px;"&gt;AuthController@logout:&lt;br&gt;$redis_keys = Redis::keys("user:$user_id:*");&lt;br&gt;foreach (...) { Redis::del(...); }&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="background-color:#fff3e0;font-size:10px;border-top:1px solid #ddd;color:#666;"&gt;⚠️ Atomic cleanup — prevents orphaned keys&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#fd7e14;strokeWidth=2;verticalAlign=top;overflow=hidden;fontSize=11;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="390" y="990" width="290" height="150" as="geometry" />
        </mxCell>

        <!-- Redis -> users dashed line (shows they reference user IDs) -->
        <mxCell id="rel-redis-users" style="edgeStyle=entityRelationEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888;strokeWidth=1.5;dashed=1;endArrow=open;endFill=0;startArrow=none;startFill=0;" edge="1" parent="1">
          <mxGeometry width="100" height="100" relative="1" as="geometry">
            <mxPoint x="185" y="340" as="sourcePoint" />
            <mxPoint x="185" y="810" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value='&lt;table border="0" cellpadding="3" cellspacing="0" width="100%"&gt;&lt;tr&gt;&lt;td style="font-weight:bold;font-size:11px;text-align:center;" colspan="2"&gt;🔑 Legend&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;🔑 PK&lt;/td&gt;&lt;td&gt;Primary Key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;🔗 FK&lt;/td&gt;&lt;td&gt;Foreign Key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1—→ ∞&lt;/td&gt;&lt;td&gt;One to Many&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;- - -&lt;/td&gt;&lt;td&gt;References (Redis → MySQL)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#ccc;strokeWidth=1;verticalAlign=top;overflow=hidden;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="200" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
